[Unit]
Description=Mahan Router core-agent
Documentation=https://github.com/ashayesteh86/MahanRouter
# nftables.service loads the last committed ruleset before the network
# comes up; the agent then renames ports and reconciles everything else.
After=systemd-networkd.service nftables.service
Wants=systemd-networkd.service

[Service]
Type=simple
ExecStart=/usr/sbin/mahan-agent --state /var/lib/mahan-router --socket /run/mahan-router/agent.sock --panel-listen :443 --panel-http :80
Restart=always
RestartSec=2
RuntimeDirectory=mahan-router
RuntimeDirectoryMode=0750
StateDirectory=mahan-router
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
