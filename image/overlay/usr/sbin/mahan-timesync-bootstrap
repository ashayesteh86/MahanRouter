#!/bin/bash
# Breaks the clock/DNSSEC loop on boxes without a good hardware clock
# (VMware often hands out a clock years off): Unbound rejects every
# DNSSEC signature as expired or not yet valid, so chrony cannot resolve
# its NTP pool, so the clock is never fixed.
#
# While chrony has no source, resolve the configured NTP names with
# DNSSEC checking disabled (+cd), hand the addresses to chrony, step the
# clock, then flush Unbound's bogus cache so validation works normally.
set -u
synced() {
  local ref
  ref=$(chronyc -n tracking 2>/dev/null | awk -F': ' '/^Reference ID/{print $2}')
  [ -n "$ref" ] && [ "${ref%% *}" != 00000000 ] && [ "${ref%% *}" != 7F7F0101 ]
}
ntp_names() {
  grep -hE '^\s*(pool|server)\s' /etc/chrony/sources.d/*.sources /etc/chrony/chrony.conf 2>/dev/null |
    awk '{print $2}' | grep -vE '^[0-9.:]+$' | awk '!seen[$0]++'
}
resolve() { # name -> IPv4 addresses, checking disabled
  local ns out
  for ns in 127.0.0.1 1.1.1.1 8.8.8.8; do
    out=$(dig +cd +short +time=2 +tries=1 A "$1" @"$ns" 2>/dev/null | grep -E '^[0-9]+(\.[0-9]+){3}$')
    [ -n "$out" ] && { echo "$out"; return 0; }
  done
  return 1
}

sleep 20 # give the normal path a chance first
for attempt in $(seq 30); do
  synced && { echo "clock synchronised"; exit 0; }
  added=0
  for name in $(ntp_names); do
    for ip in $(resolve "$name" | head -4); do
      chronyc add server "$ip" iburst >/dev/null 2>&1 && added=$((added+1))
    done
  done
  echo "attempt $attempt: clock not synchronised, added $added NTP addresses"
  if [ "$added" -gt 0 ] && chronyc waitsync 12 0 0 1 >/dev/null 2>&1; then
    chronyc makestep >/dev/null
    hwclock --systohc 2>/dev/null
    unbound-control flush_bogus >/dev/null 2>&1
    unbound-control flush_negative >/dev/null 2>&1
    echo "clock set to $(date -u '+%F %T') UTC"
    exit 0
  fi
  sleep $(( attempt < 6 ? 10 : 60 ))
done
echo "gave up: no NTP server reachable"
