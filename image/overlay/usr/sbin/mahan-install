#!/bin/bash
# Installs Mahan Router from the live ISO onto a disk.
#
#   mahan-install                 interactive: pick a disk, confirm, install
#   mahan-install --yes /dev/sda  no questions (scripts)
#   mahan-install --from-cmdline  used by the boot menu (mahan.install) and
#                                 by tests (mahan.autoinstall=/dev/sda)
#
# Layout (MBR/msdos, boots on BIOS and UEFI):
#   1  512 MiB  EFI system (FAT32, type 0xef)
#   2  rest     root (ext4, label mahan-root, active/boot flag)
# MBR, not GPT: some BIOSes (VMware's among them) report "No bootable device"
# for a GPT disk whose protective MBR has no active partition. GRUB for BIOS
# lives in the gap after the MBR; UEFI boots EFI/BOOT/BOOTX64.EFI from the ESP.
# Any configuration made in the live session is copied to the disk.
set -euo pipefail

SRC=/run/live/rootfs/filesystem.squashfs
TARGET=/mnt/mahan-target
YES=0
DISK=""
REBOOT=0
FROM_BOOT=0

die() { echo "error: $*" >&2; exit 1; }

case "${1:-}" in
  --yes) YES=1; DISK=${2:-} ;;
  --from-cmdline)
    FROM_BOOT=1
    for arg in $(cat /proc/cmdline); do
      case "$arg" in
        mahan.autoinstall=*) DISK=${arg#*=}; YES=1; REBOOT=1
          exec > >(tee /dev/console /var/log/mahan-install.log) 2>&1 ;;  # unattended: progress on the console too
      esac
    done ;;
  "") ;;
  -h|--help) sed -n '2,13p' "$0"; exit 0 ;;
  *) DISK=$1 ;;
esac

[ "$(id -u)" = 0 ] || die "run as root"
[ -d "$SRC/usr" ] || die "live root not found at $SRC (run this from the Mahan Router ISO)"

# The disk the ISO itself is on must never be offered.
LIVE_DEV=$(findmnt -n -o SOURCE /run/live/medium 2>/dev/null | sed 's/[0-9]*$//;s/p$//' || true)

list_disks() { # disks of at least 2 GB, without the ISO, CD, floppy, loop or RAM devices
  lsblk -dbn -o NAME,SIZE,TYPE | awk '$3=="disk" && $2>=2*1024^3 {print $1}' | while read -r name; do
    [ "/dev/$name" = "$LIVE_DEV" ] && continue
    case $name in loop*|sr*|fd*|ram*|zram*) continue ;; esac
    echo "/dev/$name $(lsblk -dn -o SIZE,MODEL "/dev/$name" | xargs)"
  done
}

if [ -z "$DISK" ]; then
  if [ "$FROM_BOOT" = 1 ]; then
    # Started at boot: wait until the other boot jobs are done, keep kernel
    # messages off the console, then start from a clean screen.
    dmesg -n 1 2>/dev/null || true
    for _ in $(seq 90); do
      [ -z "$(systemctl list-jobs --no-legend 2>/dev/null | grep -v mahan-installer)" ] && break
      sleep 1
    done
    # Stop systemd status lines ("Started …", timers later on) from being
    # printed over the questions.
    kill -s RTMIN+21 1 2>/dev/null || true
    printf '\033c'   # reset + clear the console
  fi
  echo
  echo "  Mahan Router installer"
  echo "  ======================"
  echo
  mapfile -t DISKS < <(list_disks)
  [ ${#DISKS[@]} -gt 0 ] || die "no installable disk found"
  for i in "${!DISKS[@]}"; do echo "  $((i+1))) ${DISKS[$i]}"; done
  echo
  while :; do
    read -rp "  Install to which disk? [1-${#DISKS[@]}, Enter = 1] " n
    n=${n:-1}
    [[ "$n" =~ ^[0-9]+$ ]] && [ "$n" -ge 1 ] && [ "$n" -le ${#DISKS[@]} ] && break
    echo "  Please type a number from the list."
  done
  DISK=$(echo "${DISKS[$((n-1))]}" | cut -d' ' -f1)
fi
[ -b "$DISK" ] || die "$DISK is not a block device"
[ "$DISK" != "$LIVE_DEV" ] || die "$DISK holds the running ISO"

if [ "$YES" != 1 ]; then
  echo
  echo "  ALL DATA ON $DISK WILL BE ERASED."
  while :; do
    read -rp "  Type YES to continue (or NO to cancel): " ok
    [ "$ok" = YES ] && break
    case "$ok" in [Nn][Oo]) echo "  Cancelled. Run mahan-install to start again."; exit 0 ;; esac
    echo "  Please type YES in capital letters."
  done
fi

part() { case "$DISK" in *[0-9]) echo "${DISK}p$1" ;; *) echo "${DISK}$1" ;; esac; }

echo ">> partitioning $DISK"
trap 'echo "error: installation failed at line $LINENO" >&2' ERR
umount -R "$TARGET" 2>/dev/null || true
wipefs -aq "$DISK"
parted -s "$DISK" mklabel msdos \
  mkpart primary fat32 1MiB 513MiB set 1 esp on \
  mkpart primary ext4 513MiB 100% set 2 boot on
partprobe "$DISK" 2>/dev/null || true
udevadm settle
for _ in $(seq 20); do [ -b "$(part 2)" ] && break; sleep 0.5; done

echo ">> creating filesystems"
mkfs.vfat -F32 -n MAHAN-EFI "$(part 1)" >/dev/null
mkfs.ext4 -q -F -L mahan-root "$(part 2)"

echo ">> copying system (takes a minute)"
mkdir -p "$TARGET"
mount "$(part 2)" "$TARGET"
cp -a "$SRC/." "$TARGET/"
mkdir -p "$TARGET/boot/efi"
mount "$(part 1)" "$TARGET/boot/efi"

# Keep what was configured in the live session.
if [ -d /var/lib/mahan-router/repo ]; then
  echo ">> keeping the configuration made in the live session"
  rm -rf "$TARGET/var/lib/mahan-router"
  cp -a /var/lib/mahan-router "$TARGET/var/lib/"
fi
[ -f /etc/shadow ] && cp -a /etc/shadow "$TARGET/etc/shadow"   # keeps a changed root password
grep -qw mahan.selftest /proc/cmdline && touch "$TARGET/etc/mahan-router/selftest-on-boot"

cat > "$TARGET/etc/fstab" <<EOF
UUID=$(blkid -s UUID -o value "$(part 2)") / ext4 errors=remount-ro 0 1
UUID=$(blkid -s UUID -o value "$(part 1)") /boot/efi vfat umask=0077 0 1
EOF
: > "$TARGET/etc/machine-id"
# The installer unit only belongs to the ISO. On the disk its Conflicts= with
# getty@tty1 would stop the login prompt, leaving a black VMware console.
rm -f "$TARGET/etc/systemd/system/multi-user.target.wants/mahan-installer.service" \
      "$TARGET/etc/systemd/system/mahan-installer.service"

echo ">> installing boot loader (BIOS + UEFI)"
for d in dev proc sys run; do mount --rbind "/$d" "$TARGET/$d"; mount --make-rslave "$TARGET/$d"; done
LOG=/var/log/mahan-install-chroot.log
step() { # label command...
  local label=$1; shift
  echo "   - $label"
  if ! timeout 1200 chroot "$TARGET" /usr/bin/env DEBIAN_FRONTEND=noninteractive "$@" >>"$LOG" 2>&1; then
    echo "   ! $label failed, see $LOG"; tail -15 "$LOG"; return 1
  fi
}
echo "   - removing live-boot"
chroot "$TARGET" /usr/bin/env DEBIAN_FRONTEND=noninteractive apt-get -y -qq purge live-boot live-boot-initramfs-tools >>"$LOG" 2>&1 </dev/null || true
ls "$TARGET"/boot/initrd.img-* >/dev/null 2>&1 || step "building initramfs" update-initramfs -c -k all
step "GRUB for BIOS" grub-install --target=i386-pc "$DISK"
step "GRUB for UEFI" grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=mahan --removable --no-nvram
step "GRUB menu" update-grub
sync
umount -lR "$TARGET"

echo
echo "  Mahan Router is installed on $DISK."
if [ "$REBOOT" = 1 ]; then
  sync; sleep 2; systemctl reboot; exit 0
fi
echo "  The ISO will be ejected. If the VM still boots the ISO, disconnect the CD."
echo
read -rp "  Press Enter to reboot into Mahan Router... " _ || true
eject -m /dev/sr0 >/dev/null 2>&1 || eject /dev/cdrom >/dev/null 2>&1 || true
sync
systemctl reboot
