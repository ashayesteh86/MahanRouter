#!/bin/bash
# Prints a health report: used by the automated VM test and by support.
# --boot: wait for the agent's first apply, then copy the report to the
# serial console (opened fresh, so a getty hang-up cannot swallow it).
LOG=/var/log/mahan-selftest.txt
if [ "${1:-}" = --boot ]; then
  for _ in $(seq 120); do
    journalctl -u mahan-agent -b -o cat | grep -qE 'boot apply|boot apply failed' && break
    sleep 5
  done
  sleep 30
  for _ in $(seq 36); do # wait for the clock (mahan-timesync-bootstrap)
    chronyc -n tracking 2>/dev/null | grep -qE '^Reference ID +: (00000000|7F7F0101)' || break
    sleep 5
  done
  "$0" > "$LOG" 2>&1
  for tty in /dev/ttyS0 /dev/console; do cat "$LOG" > "$tty" 2>/dev/null; done
  exit 0
fi
echo "=== MAHAN SELFTEST BEGIN ==="
echo "--- version"; cat /etc/mahan-router/version 2>/dev/null
echo "--- boot"; grep -q boot=live /proc/cmdline && echo live || echo installed
echo "--- clock"; date -u '+clock %Y-%m-%d %H:%M UTC'; journalctl -u mahan-timesync-bootstrap -b -o cat --no-pager | tail -3
echo "--- services"
for s in mahan-agent systemd-networkd nftables kea-dhcp4-server unbound frr chrony ssh; do
  printf '%-18s %s\n' "$s" "$(systemctl is-active $s)"
done
echo "--- vpn programs"
for b in accel-pppd sstpc pptp xl2tpd swanctl sing-box rozaneh wg mahan-eoip openvpn; do
  printf '%-12s %s\n' "$b" "$(command -v $b >/dev/null && echo present || echo missing)"
done
accel-pppd -V 2>&1 | head -1
printf 'network-manager %s\n' "$(dpkg -s network-manager >/dev/null 2>&1 && echo installed || echo absent)"
for s in xl2tpd strongswan mahan-ppp-server; do printf "%-18s %s\n" "$s" "$(systemctl is-active $s)"; done
echo "--- links"; ip -br link
echo "--- addresses"; ip -br addr
echo "--- routes"; ip route
echo "--- networkctl"; networkctl list --no-pager
echo "--- history"; mrctl history
echo "--- nft"; nft list table inet mahan | head -60
echo "--- kea leases"; cat /var/lib/kea/kea-leases4.csv 2>/dev/null | tail -5
echo "--- dns"; timeout 5 getent hosts deb.debian.org || echo "dns lookup failed"
echo "--- agent log"; journalctl -u mahan-agent -b --no-pager | tail -25
echo "--- failed units"; systemctl --failed --no-pager --plain
echo "=== MAHAN SELFTEST END ==="
