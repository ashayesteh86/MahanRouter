GRUB_DEFAULT=0
GRUB_TIMEOUT=2
GRUB_DISTRIBUTOR="Mahan Router"
GRUB_CMDLINE_LINUX_DEFAULT=""
GRUB_CMDLINE_LINUX="nomodeset console=ttyS0,115200 console=tty0"
GRUB_TERMINAL="console"
# keep, not text: UEFI has no text mode, so "text" made GRUB boot the kernel
# "in blind mode" (black screen on VMware EFI). keep = VGA text on BIOS,
# the firmware framebuffer (efifb) on UEFI. nomodeset still keeps vmwgfx off.
GRUB_GFXPAYLOAD_LINUX=keep
